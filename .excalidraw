      "updated": 1746219272800,
      "link": null,
      "locked": false,
      "text": "* Left most search\n\nwhile l <= h:\n    m = l + r // 2\n    if arr[mid] < target:\n        l = mid + 1\n    else:\n        h = mid - 1\n# l ends up at the leftmost occurance\n        ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Left most search\n\nwhile l <= h:\n    m = l + r // 2\n    if arr[mid] < target:\n        l = mid + 1\n    else:\n        h = mid - 1\n# l ends up at the leftmost occurance\n        ",
      "autoResize": true,
      "lineHeight": 1.25
    },
