      "link": null,
      "locked": false,
      "text": "Input sizes and expected time complexities\n\n* n <= 10 ----------------O(n!)\n\n* n <= 20 ---------------O(2^n)\n\n* n <= 500---------------O(n^3)\n\n* n <= 5000-------------O(n^2)\n\n* n <= 10^6--------------O(nlog n) or O(n)\n\n* n > 10^6----------------O(log n) or O(1)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Input sizes and expected time complexities\n\n* n <= 10 ----------------O(n!)\n\n* n <= 20 ---------------O(2^n)\n\n* n <= 500---------------O(n^3)\n\n* n <= 5000-------------O(n^2)\n\n* n <= 10^6--------------O(nlog n) or O(n)\n\n* n > 10^6----------------O(log n) or O(1)",
      "autoResize": true,
